{
  "name": "xrift-item-carry",
  "version": "0.1.0",
  "description": "Reusable React Three Fiber hook for grabbing, carrying and yaw-rotating XRift items.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/carry.d.ts",
      "import": "./dist/carry.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "test:browser": "node tests/browser-check.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "demo:setup": "npm run build && npm --prefix demo-item ci",
    "demo:dev": "npm --prefix demo-item run dev",
    "demo:build": "npm run build && npm --prefix demo-item run build",
    "demo:check": "npm --prefix demo-item run check",
    "demo:upload": "npm --prefix demo-item run upload",
    "test:demo:browser": "node tests/demo-browser-check.mjs"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "three": "^0.183.1",
    "typescript": "^5.6.2",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "xrift",
    "react-three-fiber",
    "webxr",
    "drag",
    "carry"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orange3134/xrift-item-carry.git"
  },
  "homepage": "https://github.com/orange3134/xrift-item-carry#readme",
  "bugs": {
    "url": "https://github.com/orange3134/xrift-item-carry/issues"
  }
}
